# Event Reminder Bot configuration — copy to data/.env and fill in real values.
# Never commit .env (gitignored).

# --- Telegram (required if using Telegram) ---
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
                               # multiple chats: comma-separated, e.g. 123456,654231

# --- Email / SMTP (required if using email) ---
# Gmail defaults shown below: host smtp.gmail.com, port 587, use STARTTLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
SMTP_FROM=you@gmail.com        # optional, defaults to SMTP_USER
MAIL_TO=you@gmail.com           # optional, defaults to SMTP_USER
                                 # multiple recipients: comma-separated, no spaces needed
# MAIL_TO=you@gmail.com,other@example.com
SMTP_USE_SSL=false              # false = port 587 STARTTLS; true = port 465 implicit TLS

# --- Runtime (optional, defaults shown) ---
# DATA_DIR=./data          # holds event.csv, state.json, .env
# EVENT_CSV=./data/event.csv
# STATE_JSON=./data/state.json
CHECK_HOUR=11
TZ_NAME=Europe/London
DRY_RUN=0
# OVERRIDE_TODAY=          # YYYY-MM-DD: force "today" (local testing only)
# ONCE=0                   # 1 = run one pass and exit (also: python bot.py --once)
